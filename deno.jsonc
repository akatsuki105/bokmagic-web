{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "imports": {
    "preact": "npm:preact@^10",
    // サウンド再生ロジックは m4a-web (https://github.com/akatsuki105/m4a-web) のを使う
    "m4a/": "https://raw.githubusercontent.com/akatsuki105/m4a-web/cbbb6e10b00f301b28ef2f4bcb3c5afa71bd9406/m4a/"
  },
  "fmt": {
    "lineWidth": 1000, // I hate line wrapping
    "exclude": ["bokcc/"] // boktai2 decomp からのコピーなので手を入れない
  },
  "lint": {
    "exclude": ["bokcc/"]
  },
  "tasks": {
    "dev:bundle": "deno bundle --sourcemap --watch --platform=browser index.tsx -o bundle.js",
    "dev:server": "deno run --allow-net --allow-read jsr:@std/http/file-server --host=localhost --port=8080",
    "dev": {
      "dependencies": ["dev:bundle", "dev:server"]
    },
    "bundle": "deno bundle --platform=browser index.tsx -o bundle.js",
    // コマンドライン版を 1 ファイルにまとめる (decomp 側などに持っていって deno run で動かす)
    "cli:bundle": "deno bundle --platform=deno cli/main.ts -o dist/bokmagic.js"
  }
}
